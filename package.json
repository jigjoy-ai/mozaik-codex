{
	"name": "mozaik-codex",
	"version": "0.2.0",
	"private": true,
	"description": "Connects Codex sessions to a Mozaik network: see the other sessions and exchange messages with them.",
	"license": "MIT",
	"bin": {
		"mozaik-codex": "dist/server.cjs"
	},
	"scripts": {
		"build": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node22 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/server.cjs",
		"test": "rstest run",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@mozaik-ai/network-client": "^0.1.0"
	},
	"devDependencies": {
		"@rstest/core": "0.12.4",
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"mozaik-network": "github:jigjoy-ai/mozaik-network#development",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
